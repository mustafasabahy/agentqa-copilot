# Run scripts/create_admin.py once; keep this token server-side or in the UI login field.
AGENTQA_ADMIN_TOKEN=
AGENTQA_DB=data/platform.sqlite
# Exact origins. Private addresses require explicit server-side permission below.
AGENTQA_ALLOWED_ORIGINS=http://127.0.0.1:8124
AGENTQA_ALLOW_PRIVATE_TARGETS=false
AGENTQA_MODEL=openai:gpt-5.4-mini-2026-03-17
AGENTQA_COPILOT_MODEL=openai:gpt-5.4-mini-2026-03-17
AGENTQA_GENERATION_MODEL=openai:gpt-5.4-mini-2026-03-17
AGENTQA_JUDGE_MODEL=openai:gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agentqa-copilot
# Provider acceptance scope disables tracing until separate remote authorization exists.
# Configure conservatively for your model/provider. Dollar reservation per call.
AGENTQA_CALL_RESERVATION=0.25
AGENTQA_LLM_MAX_TOKENS=2048
AGENTQA_GENERATION_MAX_TOKENS=12000

# Deliberate acknowledgement: transport enforces requests and reservations, not external billing.
AGENTQA_ALLOW_ESTIMATED_LIVE_COSTS=false
# Populate only after independently verifying fictional data and isolation.
# Target must expose matching /.well-known/agentqa-isolation metadata.
AGENTQA_ISOLATED_DEPLOYMENTS={}
# Example target credential; never send provider API keys to a target.
AGENTQA_TARGET_DEMO_TOKEN=

# Optional private local source; excluded from public Git history.
AGENTQA_HR_REFERENCE=
